// PHASE 2: AUTHENTICATION MIGRATION
// This is the complete schema addition for Phase 2
// Add these to the existing schema.prisma file

// ============ PHASE 2: AUTHENTICATION ENUMS ============

enum UserRole {
  ADMIN
  PLACEMENT_OFFICER
  RECRUITER
  STUDENT
}

enum AccountStatus {
  EMAIL_PENDING
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrganizationType {
  COLLEGE
  UNIVERSITY
  BOOTCAMP
  TRAINING_INSTITUTE
  MSME
  STARTUP
  COMPANY
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_RESET
  EMAIL_VERIFIED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  RECRUITER_VERIFIED
  RECRUITER_REJECTED
  USER_SUSPENDED
  USER_ACTIVE
}

enum NotificationType {
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  JOB_APPLICATION
  INTERVIEW_SCHEDULED
  OFFER_RECEIVED
}

enum NotificationChannel {
  DATABASE
  EMAIL
  PUSH
  SMS
}

// ============ PHASE 2: AUTHENTICATION MODELS ============

model Organization {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   @unique
  type             OrganizationType
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  state            String?
  country          String?
  logo             String?
  description      String?
  verified         Boolean  @default(false)
  isActive         Boolean  @default(true)

  // Relations
  students            StudentProfile[]
  recruiters          RecruiterProfile[]
  placementOfficers   PlacementOfficerProfile[]
  invitations         Invitation[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  users               User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([verified])
  @@index([isActive])
}

model StudentProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  rollNumber       String?
  courseYear       String?
  branch           String?
  cgpa             Float?
  tenthBoard       String?
  tenthScore       Float?
  twelfthBoard     String?
  twelfthScore     Float?
  resumeUrl        String?
  linkedinUrl      String?
  githubUrl        String?
  skills           String[] @default([])
  interests        String[] @default([])
  experiences      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model RecruiterProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  companyName      String
  designation      String
  department       String?
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  verificationNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([verified])
}

model PlacementOfficerProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  designation      String
  department       String?
  officePhone      String?
  verified         Boolean  @default(false)
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([verified])
}

model Invitation {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  role             UserRole
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  invitedByUserId  String   @db.ObjectId
  invitedByUser    User     @relation("invitedBy", fields: [invitedByUserId], references: [id])
  
  acceptedByUserId String?  @db.ObjectId
  acceptedByUser   User?    @relation("invitedUser", fields: [acceptedByUserId], references: [id])
  
  token            String   @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  status           String   @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId, role])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
}

model PhaseRefreshToken {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  token            String   @unique
  userId           String   @db.ObjectId
  user             User     @relation("phase2RefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  revokedAt        DateTime?
  isRevoked        Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             UserRole @unique
  permissions      String[] @default([])
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  targetUserId     String   @db.ObjectId
  targetUser       User     @relation("auditLogTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  performedByUserId String  @db.ObjectId
  performedByUser  User     @relation("auditLogPerformedBy", fields: [performedByUserId], references: [id], onDelete: Cascade)
  
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  action           AuditAction
  resourceType     String?
  resourceId       String?
  changes          Json?
  ipAddress        String?
  userAgent        String?
  status           String   @default("SUCCESS")

  createdAt DateTime @default(now())

  @@index([targetUserId])
  @@index([performedByUserId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String   @db.ObjectId
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  type             NotificationType
  title            String
  message          String
  channels         NotificationChannel[]
  
  read             Boolean  @default(false)
  readAt           DateTime?
  
  sentViaEmail     Boolean  @default(false)
  sentViaPush      Boolean  @default(false)
  sentViaSMS       Boolean  @default(false)
  
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

